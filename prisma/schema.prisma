generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           BigInt     @id @default(autoincrement())
  email        String     @unique
  name         String     @default("")
  passwordHash String     @map("password_hash")
  role         String
  balance      Int        @default(0)
  createdAt    BigInt     @map("created_at")
  novels       Novel[]
  progress     Progress[]
  favorites    Favorite[]
  sessions     Session[]
  creditEntries CreditEntry[]
  reviews      Review[]
  reviewReports ReviewReport[]

  @@map("users")
}

model Novel {
  id            BigInt         @id @default(autoincrement())
  ownerId       BigInt         @map("owner_id")
  title         String
  description   String         @default("")
  titleMy       String         @default("") @map("title_my")
  descriptionMy String         @default("") @map("description_my")
  sourceTitle   String         @default("") @map("source_title")
  sourceContent String         @default("") @map("source_content")
  sourceAuthor  String         @default("") @map("source_author")
  originAuthor  String         @default("") @map("origin_author")
  genre         String         @default("english")
  status        String         @default("ongoing")
  language      String         @default("english")
  hidden        Boolean        @default(true)
  slug          String         @unique
  createdAt     BigInt         @map("created_at")
  updatedAt     BigInt         @map("updated_at")
  owner         User           @relation(fields: [ownerId], references: [id])
  chapters      Chapter[]
  progress      Progress[]
  favorites     Favorite[]
  glossary      GlossaryTerm[]
  reviews       Review[]
  genreLinks    NovelGenre[]

  @@map("novels")
}

model NovelGenre {
  novelId  BigInt @map("novel_id")
  slug     String
  position Int    @default(0)
  novel    Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@id([novelId, slug])
  @@map("novel_genres")
}

model Review {
  id        BigInt         @id @default(autoincrement())
  userId    BigInt         @map("user_id")
  novelId   BigInt         @map("novel_id")
  rating    Int
  body      String         @default("")
  hidden    Boolean        @default(false)
  createdAt BigInt         @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel          @relation(fields: [novelId], references: [id], onDelete: Cascade)
  reports   ReviewReport[]

  @@unique([userId, novelId])
  @@map("reviews")
}

model ReviewReport {
  id        BigInt @id @default(autoincrement())
  reviewId  BigInt @map("review_id")
  userId    BigInt @map("user_id")
  reason    String
  createdAt BigInt @map("created_at")
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_reports")
}

model Chapter {
  id        BigInt     @id @default(autoincrement())
  novelId   BigInt     @map("novel_id")
  number    Int
  title     String
  body      String
  titleMy   String     @default("") @map("title_my")
  bodyMy    String     @default("") @map("body_my")
  hidden    Boolean    @default(true)
  createdAt BigInt     @map("created_at")
  updatedAt BigInt     @map("updated_at")
  novel     Novel      @relation(fields: [novelId], references: [id], onDelete: Cascade)
  progress  Progress[]

  @@unique([novelId, number])
  @@map("chapters")
}

model Genre {
  id       BigInt @id @default(autoincrement())
  slug     String @unique
  label    String
  labelMy  String @default("") @map("label_my")
  position Int    @default(0)

  @@map("genres")
}

model CreditSettings {
  id           Int    @id
  dailyFree    Int    @default(1) @map("daily_free")
  chapterPrice Int    @default(1) @map("chapter_price")
  freeChapters Int    @default(3) @map("free_chapters")
  resetLabel   String @default("00:00 Thailand time") @map("reset_label")

  @@map("credit_settings")
}

model CreditEntry {
  id           BigInt @id @default(autoincrement())
  userId       BigInt @map("user_id")
  kind         String
  amount       Int
  note         String @default("")
  actor        String @default("System")
  balanceAfter Int    @map("balance_after")
  createdAt    BigInt @map("created_at")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_entries")
}

model Promotion {
  id        BigInt  @id @default(autoincrement())
  name      String
  kind      String
  value     Int
  scope     String  @default("all")
  startsOn  String  @default("") @map("starts_on")
  endsOn    String  @default("") @map("ends_on")
  active    Boolean @default(true)
  createdAt BigInt  @map("created_at")

  @@map("promotions")
}

model GlossaryTerm {
  id      BigInt @id @default(autoincrement())
  novelId BigInt @map("novel_id")
  source  String
  burmese String
  note    String @default("")
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, source])
  @@map("glossary_terms")
}

model Favorite {
  userId    BigInt @map("user_id")
  novelId   BigInt @map("novel_id")
  createdAt BigInt @map("created_at")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@id([userId, novelId])
  @@map("favorites")
}

model Progress {
  userId    BigInt  @map("user_id")
  novelId   BigInt  @map("novel_id")
  chapterId BigInt  @map("chapter_id")
  updatedAt BigInt  @map("updated_at")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, novelId])
  @@map("progress")
}

model Session {
  idHash    String @id @map("id_hash")
  userId    BigInt @map("user_id")
  expiresAt BigInt @map("expires_at")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
