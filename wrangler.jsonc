{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "novels",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-11-24",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
    "observability": {
      "enabled": false,
      "head_sampling_rate": 1,
      "redact_query_string": false,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issues": {
        "enabled": true
      },
      
  },
  "hyperdrive": [
        {
          "binding": "MY_NOVELS",
          "id": "d96e6c9cb513495aae6ce14e54885fa1"
        }
      ],
  "vars": {
    "OPEN_NEXT_USE_WEB_SOCKETS": "true"
  }
}