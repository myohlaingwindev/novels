{
  "name": "novels",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && node scripts/trim-worker-wasm.mjs",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "start": "next start",
    "test": "vitest run",
    "admin": "node --import ./scripts/wasm-module-hook.mjs --import tsx scripts/admin.ts",
    "seed": "node --import ./scripts/wasm-module-hook.mjs --import tsx scripts/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.19",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.5",
    "node-html-parser": "^9.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "^7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "^4.168.0"
  }
}
